rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ───────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(uid())).data.role == 'admin';
    }

    // ── users ─────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && uid() == userId;
      allow update: if isSignedIn() && (uid() == userId || isAdmin());
      allow delete: if isAdmin();

      // FCM tokens — only the owner writes their own tokens
      match /fcmTokens/{tokenId} {
        allow read: if isSignedIn() && uid() == userId;
        allow write: if isSignedIn() && uid() == userId;
      }

      // Favorites — only the owner reads/writes
      match /favorites/{propertyId} {
        allow read: if isSignedIn() && uid() == userId;
        allow write: if isSignedIn() && uid() == userId;
      }
    }

    // ── properties ────────────────────────────────────────────────────────────
    match /properties/{propertyId} {
      // Public read — listings are visible to everyone
      allow read: if true;
      // Any signed-in user can list a property
      allow create: if isSignedIn();
      // Only owner or admin can update
      allow update: if isSignedIn() && (
        resource.data.uploadedBy == uid() ||
        resource.data.createdBy == uid() ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ── offers / deals ────────────────────────────────────────────────────────
    // FIX: Separate list and get so .where() queries work for buyers/sellers
    match /offers/{offerId} {
      // allow list (for .where() queries like buyerDeals, brokerDeals)
      allow list: if isSignedIn();

      // allow get (single document read)
      allow get: if isSignedIn() && (
        resource.data.buyerId == uid() ||
        resource.data.sellerId == uid() ||
        resource.data.brokerId == uid() ||
        isAdmin()
      );

      // Any signed-in user can create an offer
      allow create: if isSignedIn();

      // Only parties to the deal can update
      allow update: if isSignedIn() && (
        resource.data.buyerId == uid() ||
        resource.data.sellerId == uid() ||
        resource.data.brokerId == uid() ||
        isAdmin()
      );

      allow delete: if isAdmin();
    }

    // ── escrow ────────────────────────────────────────────────────────────────
    match /escrow/{escrowId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn() && (
        resource.data.buyerId == uid() ||
        resource.data.brokerId == uid() ||
        isAdmin()
      );
      allow create: if isSignedIn();
      // Only admin / Cloud Functions update escrow (release/refund)
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ── escrows (alternate name used by some services) ────────────────────────
    match /escrows/{escrowId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn() && (
        resource.data.buyerId == uid() ||
        resource.data.brokerId == uid() ||
        isAdmin()
      );
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ── platform_fees — EstateX revenue records ───────────────────────────────
    match /platform_fees/{feeId} {
      allow read: if isAdmin();
      // Created by buyer client when paying token
      allow create: if isSignedIn();
      // Only admin marks as collected
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ── agreements ────────────────────────────────────────────────────────────
    match /agreements/{agreementId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn() && (
        resource.data.buyerId == uid() ||
        resource.data.sellerId == uid() ||
        resource.data.brokerId == uid() ||
        isAdmin()
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        resource.data.buyerId == uid() ||
        resource.data.sellerId == uid() ||
        resource.data.brokerId == uid() ||
        isAdmin()
      );
      allow delete: if false;
    }

    // ── leads ─────────────────────────────────────────────────────────────────
    match /leads/{leadId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn() && (
        resource.data.brokerId == uid() ||
        resource.data.buyerId == uid() ||
        isAdmin()
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        resource.data.brokerId == uid() || isAdmin()
      );
      allow delete: if isSignedIn() && (
        resource.data.brokerId == uid() || isAdmin()
      );
    }

    // ── reviews ───────────────────────────────────────────────────────────────
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() &&
        request.resource.data.reviewerId == uid();
      allow update: if false;
      allow delete: if isSignedIn() && (
        resource.data.reviewerId == uid() || isAdmin()
      );
    }

    // ── disputes ──────────────────────────────────────────────────────────────
    match /disputes/{disputeId} {
      allow list: if isAdmin();
      allow get: if isSignedIn() && (
        resource.data.buyerId == uid() ||
        resource.data.sellerId == uid() ||
        isAdmin()
      );
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ── fraud_alerts ──────────────────────────────────────────────────────────
    match /fraud_alerts/{alertId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ── admin_metrics_daily ───────────────────────────────────────────────────
    // Non-admin writes silently blocked here so native SDK stops retrying
    match /admin_metrics_daily/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ── property_audit_logs ───────────────────────────────────────────────────
    match /property_audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ── notifications ─────────────────────────────────────────────────────────
    match /notifications/{notifId} {
      // List own notifications
      allow list: if isSignedIn();
      allow get: if isSignedIn() && resource.data.userId == uid();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.userId == uid();
      allow delete: if isSignedIn() && resource.data.userId == uid();
    }

    // ── activities ────────────────────────────────────────────────────────────
    match /activities/{activityId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn() && resource.data.userId == uid();
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    // ── saved_searches ────────────────────────────────────────────────────────
    match /saved_searches/{searchId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn() && resource.data.userId == uid();
      allow create: if isSignedIn() &&
        request.resource.data.userId == uid();
      allow update: if isSignedIn() && resource.data.userId == uid();
      allow delete: if isSignedIn() && resource.data.userId == uid();
    }

    // ── visit_requests ────────────────────────────────────────────────────────
    match /visit_requests/{requestId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn() && (
        resource.data.buyerId == uid() ||
        resource.data.brokerId == uid() ||
        isAdmin()
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        resource.data.buyerId == uid() ||
        resource.data.brokerId == uid() ||
        isAdmin()
      );
      allow delete: if isSignedIn() && resource.data.buyerId == uid();
    }

    // ── live_tours ────────────────────────────────────────────────────────────
    match /live_tours/{tourId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        resource.data.hostId == uid() || isAdmin()
      );
      allow delete: if isSignedIn() && resource.data.hostId == uid();
    }

    // ── chat_rooms ────────────────────────────────────────────────────────────
    // FIX: CREATE must use request.resource.data (not resource.data which is null on create)
    match /chat_rooms/{chatRoomId} {
      allow list: if isSignedIn();

      allow get: if isSignedIn() && (
        resource.data.buyerId == uid() ||
        resource.data.brokerId == uid() ||
        isAdmin()
      );

      // FIX: use request.resource.data for create checks
      allow create: if isSignedIn() && (
        request.resource.data.buyerId == uid() ||
        request.resource.data.brokerId == uid()
      );

      allow update: if isSignedIn() && (
        resource.data.buyerId == uid() ||
        resource.data.brokerId == uid() ||
        isAdmin()
      );

      allow delete: if false;

      // messages subcollection
      // FIX: simplified — check senderId matches uid, no expensive get() call
      match /messages/{messageId} {
        allow list: if isSignedIn();
        allow get: if isSignedIn();

        allow create: if isSignedIn() &&
          request.resource.data.senderId == uid();

        allow update: if false;
        allow delete: if false;
      }
    }

    // ── callback_requests ─────────────────────────────────────────────────────
    match /callback_requests/{requestId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn() && (
        resource.data.buyerId == uid() ||
        resource.data.brokerId == uid() ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        request.resource.data.buyerId == uid() ||
        request.resource.data.brokerId == uid()
      );
      allow update: if isSignedIn() && (
        resource.data.buyerId == uid() ||
        resource.data.brokerId == uid() ||
        isAdmin()
      );
      allow delete: if false;
    }

    // ── admin_notifications ───────────────────────────────────────────────────
    match /admin_notifications/{notifId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── payments ──────────────────────────────────────────────────────────────
    match /payments/{paymentId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn() && (
        resource.data.buyerId == uid() ||
        resource.data.brokerId == uid() ||
        isAdmin()
      );
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if false;
    }
  }
}
